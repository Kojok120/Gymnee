{
  "name": "gymnee-connect",
  "private": true,
  "type": "module",
  "description": "Gymnee の外部連携 (#171): API・MCP・OAuth・Webhook・LINE を受け持つ Cloudflare Worker",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "openapi": "tsx scripts/write-openapi.ts",
    "openapi:check": "tsx scripts/write-openapi.ts --check",
    "e2e:local": "node scripts/e2e-local.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.6",
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "4.13.16",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/node": "^24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
